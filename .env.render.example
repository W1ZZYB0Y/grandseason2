# --- Render environment variables (set these in the Render dashboard, NOT in a file) ---
SECRET_KEY=generate-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=grandseasonshotel.ng,www.grandseasonshotel.ng

# From Neon: Dashboard -> your project -> Connection string (use the "pooled" one)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Render sets this automatically to something like your-app.onrender.com —
# only add it here manually if you're testing locally with these settings.
RENDER_EXTERNAL_HOSTNAME=

# Only needed if a custom domain isn't pointed at Render yet
CSRF_TRUSTED_ORIGINS=https://grandseasonshotel.ng,https://www.grandseasonshotel.ng
